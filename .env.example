# Copie para ".env" (no seu computador) ou cadastre na Vercel/Netlify como variáveis de ambiente.
# Supabase → Project Settings → API (ou "API Keys")
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-ou-publishable
# true para mostrar "Entrar com Google" (ative o provedor Google no Supabase antes)
VITE_GOOGLE_LOGIN=false
